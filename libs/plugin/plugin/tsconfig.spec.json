{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./out-tsc/jest",
    "types": ["jest", "node"],
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "jest.config.ts",
    "jest.config.cts",
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/**/*.d.ts",
    // TEMPORARY: the contract suite is excluded from tsconfig.lib.json (it
    // imports @jest/globals and must stay out of the runtime graph), which
    // leaves it in no project for the linter. Remove once the suite moves
    // to its own contract-testing lib.
    "src/**/*.contract.ts"
  ],
  "references": [
    {
      "path": "./tsconfig.lib.json"
    }
  ]
}
