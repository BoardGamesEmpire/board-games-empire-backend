{
  "name": "@bge/database",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/database/src",
  "projectType": "library",
  "tags": ["database", "prisma"],
  "targets": {
    "generate": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node libs/scripts/src/bin/prisma-generate.js"
      },
      "inputs": [
        "{workspaceRoot}/prisma/**/*.prisma",
        "{workspaceRoot}/prisma/migrations/**/*.sql",
        "{workspaceRoot}/prisma.config.ts",
        "{workspaceRoot}/libs/scripts/src/bin/prisma-generate.js",
        "{workspaceRoot}/libs/scripts/src/prisma-generate/**/*.js",
        "!{workspaceRoot}/libs/scripts/src/prisma-generate/**/*.spec.js",
        {
          "externalDependencies": ["prisma", "@prisma/client"]
        }
      ],
      "outputs": ["{projectRoot}/src/lib/generated"]
    },
    "prepare": {
      "dependsOn": ["generate"]
    },
    "typecheck": {
      "// dependsOn": "^generate: this project compiles @bge/i18n-core through otel → actor-context, and its key types are generated and untracked, so a cold typecheck fails without them. The union, because a project-level dependsOn replaces the nx.json default rather than merging (#312).",
      "dependsOn": ["generate", "^generate"]
    },
    "test": {
      "dependsOn": ["generate"]
    }
  }
}
