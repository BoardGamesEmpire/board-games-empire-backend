{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.lib.tsbuildinfo",
    "emitDeclarationOnly": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"],
    "target": "esnext",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src/**/*.ts"],
  "references": [
    {
      "path": "../../api/gateway-host/tsconfig.lib.json"
    },
    {
      "path": "../../common/shared/tsconfig.lib.json"
    },
    {
      "path": "../../proto/gateway/tsconfig.lib.json"
    },
    {
      "path": "../driver/runtime/tsconfig.lib.json"
    },
    {
      "path": "../../database/tsconfig.lib.json"
    },
    {
      "path": "../../common/actor-context/tsconfig.lib.json"
    },
    {
      "path": "../driver/contract/tsconfig.lib.json"
    },
    {
      "path": "../../plugin/runtime/tsconfig.lib.json"
    },
    {
      "path": "../driver/contract-testing/tsconfig.lib.json"
    }
  ],
  "exclude": ["jest.config.ts", "jest.config.cts", "src/**/*.spec.ts", "src/**/*.test.ts"]
}
