{
  "name": "@boardgamesempire/proto-gateway",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/proto/gateway/src",
  "projectType": "library",
  "tags": ["proto", "gateway"],
  "// targets": "to see all targets run: nx show project @boardgamesempire/proto-gateway --web",
  "targets": {
    "generate": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "command": "buf generate",
        "cwd": "libs/proto/gateway"
      },
      "inputs": [
        "{projectRoot}/src/proto/**/*.proto",
        "{projectRoot}/buf.gen.yaml",
        "{projectRoot}/buf.yaml",
        "{projectRoot}/buf.lock"
      ],
      "outputs": ["{projectRoot}/src/gen"]
    },
    "build": {
      "dependsOn": ["generate"]
    },
    "typecheck": {
      "dependsOn": ["generate", "^typecheck"],
      "// inputs": "The inferred list plus the generated TypeScript itself (the last entry, which hashes generate's output). src/gen is gitignored, so without it a .proto change keeps this task's hash and restores stale declarations. See docs/NX_CACHING.md.",
      "inputs": [
        "{projectRoot}/package.json",
        "{workspaceRoot}/tsconfig.base.json",
        "{projectRoot}/tsconfig.json",
        "{projectRoot}/tsconfig.lib.json",
        "{projectRoot}/src/**/*.ts",
        {
          "dependentTasksOutputFiles": "**/*.{d.ts,d.cts,d.mts,tsbuildinfo}",
          "transitive": true
        },
        {
          "fileset": "{projectRoot}/**/*.{d.ts,d.cts,d.mts}",
          "dependencies": true
        },
        {
          "dependentTasksOutputFiles": "**/*.ts"
        }
      ]
    },
    "test": {
      "dependsOn": ["generate"]
    },
    "buf-lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "buf lint",
        "cwd": "libs/proto/gateway"
      }
    },
    "buf-export": {
      "executor": "nx:run-commands",
      "options": {
        "command": "buf export src/proto --exclude-imports=false -o proto-export",
        "cwd": "libs/proto/gateway"
      }
    },
    "buf-format": {
      "executor": "nx:run-commands",
      "options": {
        "command": "buf format -w",
        "cwd": "libs/proto/gateway"
      }
    },
    "buf-format-check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "buf format --diff --exit-code",
        "cwd": "libs/proto/gateway"
      }
    },
    "buf-breaking": {
      "executor": "nx:run-commands",
      "defaultConfiguration": "local",
      "options": {
        "cwd": "libs/proto/gateway"
      },
      "configurations": {
        "local": {
          "command": "buf breaking --against '.git#branch=main,subdir=libs/proto/gateway'"
        },
        "bsr": {
          "command": "buf breaking --against 'https://buf.build/boardgamesempire/bge-gateway'"
        }
      }
    },
    "buf-push": {
      "executor": "nx:run-commands",
      "defaultConfiguration": "gateway-only",
      "options": {
        "cwd": "libs/proto/gateway/src/proto/bge/gateway"
      },
      "configurations": {
        "gateway-only": {
          "command": "buf push --label main"
        },
        "all": {
          "command": "buf push --label main",
          "cwd": "libs/proto/gateway"
        }
      }
    }
  }
}
