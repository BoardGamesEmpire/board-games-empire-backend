{
  "name": "@boardgamesempire/proto-gateway",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/proto/gateway/src",
  "projectType": "library",
  "tags": ["proto", "gateway"],
  "// targets": "to see all targets run: nx show project @boardgamesempire/proto-gateway --web",
  "targets": {
    "generate": {
      "executor": "nx:run-commands",
      "cache": true,
      "// dependsOn": "generate doesn't read proto-export, but every app build that bundles the .proto files reaches this task through ^generate, so the edge is how the export gets made before webpack copies it (#313). The directory is gitignored, and the copy skips a missing one without a word, leaving a bundle that exits as it boots.",
      "dependsOn": ["buf-export"],
      "options": {
        "command": "buf generate",
        "cwd": "libs/proto/gateway"
      },
      "inputs": [
        "{projectRoot}/src/proto/**/*.proto",
        "{projectRoot}/buf.gen.yaml",
        "{projectRoot}/buf.yaml",
        "{projectRoot}/buf.lock"
      ],
      "outputs": ["{projectRoot}/src/gen"]
    },
    "build": {
      "dependsOn": ["generate"]
    },
    "typecheck": {
      "dependsOn": ["generate", "^typecheck"],
      "// inputs": "The inferred list plus the generated TypeScript itself (the last entry, which hashes generate's output). src/gen is gitignored, so without it a .proto change keeps this task's hash and restores stale declarations. See docs/NX_CACHING.md.",
      "inputs": [
        "{projectRoot}/package.json",
        "{workspaceRoot}/tsconfig.base.json",
        "{projectRoot}/tsconfig.json",
        "{projectRoot}/tsconfig.lib.json",
        "{projectRoot}/src/**/*.ts",
        {
          "dependentTasksOutputFiles": "**/*.{d.ts,d.cts,d.mts,tsbuildinfo}",
          "transitive": true
        },
        {
          "fileset": "{projectRoot}/**/*.{d.ts,d.cts,d.mts}",
          "dependencies": true
        },
        {
          "dependentTasksOutputFiles": "**/*.ts"
        }
      ]
    },
    "test": {
      "dependsOn": ["generate"]
    },
    "buf-lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "buf lint",
        "cwd": "libs/proto/gateway"
      }
    },
    "buf-export": {
      "executor": "nx:run-commands",
      "// cache": "Uncached, like @bge/database:generate (docs/NX_CACHING.md). npm start's six Nx processes each run this for themselves, and Nx restoring a cache hit rewrites the directory whenever its daemon is off or the files on disk differ, while another app's webpack may be copying it. The script writes the directory only when the export changed, so a run costs about a tenth of a second and, usually, touches nothing (#313).",
      "cache": false,
      "options": {
        "command": "node libs/scripts/src/bin/buf-export.js"
      },
      "inputs": [
        "{projectRoot}/src/proto/**/*.proto",
        "{projectRoot}/buf.yaml",
        "{projectRoot}/buf.lock",
        "{workspaceRoot}/libs/scripts/src/bin/buf-export.js",
        "{workspaceRoot}/libs/scripts/src/proto-export/**/*.js",
        "!{workspaceRoot}/libs/scripts/src/proto-export/**/*.spec.js",
        "{workspaceRoot}/libs/scripts/src/prisma-generate/lock.js",
        {
          "externalDependencies": ["@bufbuild/buf"]
        }
      ],
      "outputs": ["{projectRoot}/proto-export"]
    },
    "buf-format": {
      "executor": "nx:run-commands",
      "options": {
        "command": "buf format -w",
        "cwd": "libs/proto/gateway"
      }
    },
    "buf-format-check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "buf format --diff --exit-code",
        "cwd": "libs/proto/gateway"
      }
    },
    "buf-breaking": {
      "executor": "nx:run-commands",
      "defaultConfiguration": "local",
      "options": {
        "cwd": "libs/proto/gateway"
      },
      "configurations": {
        "local": {
          "command": "buf breaking --against '.git#branch=main,subdir=libs/proto/gateway'"
        },
        "bsr": {
          "command": "buf breaking --against 'https://buf.build/boardgamesempire/bge-gateway'"
        }
      }
    },
    "buf-push": {
      "executor": "nx:run-commands",
      "defaultConfiguration": "gateway-only",
      "options": {
        "cwd": "libs/proto/gateway/src/proto/bge/gateway"
      },
      "configurations": {
        "gateway-only": {
          "command": "buf push --label main"
        },
        "all": {
          "command": "buf push --label main",
          "cwd": "libs/proto/gateway"
        }
      }
    }
  }
}
