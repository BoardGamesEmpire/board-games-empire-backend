{
  "name": "@bge/version",
  "version": "0.0.1",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "nx": {
    "tags": [
      "common"
    ],
    "name": "@board-games-empire/version",
    "targets": {
      "generate": {
        "executor": "nx:run-commands",
        "cache": true,
        "inputs": [
          "{workspaceRoot}/package.json",
          "{workspaceRoot}/libs/scripts/src/bin/generate-bge-version.js"
        ],
        "outputs": [
          "{projectRoot}/src/lib/generated/bge-version.ts"
        ],
        "options": {
          "command": "node libs/scripts/src/bin/generate-bge-version.js"
        }
      },
      "typecheck": {
        "dependsOn": [
          "generate",
          "^typecheck",
          "^generate"
        ]
      },
      "test": {
        "dependsOn": [
          "generate",
          "^build",
          "^generate"
        ]
      }
    }
  },
  "dependencies": {}
}
