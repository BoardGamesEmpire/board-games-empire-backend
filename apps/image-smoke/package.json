{
  "name": "@boardgamesempire/image-smoke",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "targets": {
      "smoke": {
        "executor": "nx:run-commands",
        "cache": false,
        "dependsOn": [
          "@boardgamesempire/stub-gateway:build"
        ],
        "options": {
          "command": "jest --config ./apps/image-smoke/jest.smoke.config.cts",
          "cwd": ".",
          "env": {
            "TS_NODE_COMPILER_OPTIONS": "{\"moduleResolution\":\"node10\",\"module\":\"commonjs\",\"customConditions\":null}"
          }
        }
      }
    },
    "tags": [
      "test",
      "e2e"
    ]
  }
}
