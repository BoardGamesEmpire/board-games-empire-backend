{
  "name": "@boardgamesempire/api",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "targets": {
      "generate": {
        "executor": "nx:run-commands",
        "cache": true,
        "inputs": [
          "{workspaceRoot}/package.json",
          "{workspaceRoot}/libs/scripts/src/bin/generate-bge-version.js"
        ],
        "outputs": [
          "{projectRoot}/src/app/generated/bge-version.ts"
        ],
        "options": {
          "command": "node libs/scripts/src/bin/generate-bge-version.js"
        }
      },
      "build": {
        "executor": "nx:run-commands",
        "options": {
          "command": "webpack-cli build",
          "args": [
            "--node-env=production"
          ],
          "cwd": "apps/api",
          "tsPlugins": [
            {
              "name": "@nestjs/swagger/plugin",
              "options": {
                "dtoFileNameSuffix": [
                  ".dto.ts"
                ],
                "controllerFileNameSuffix": [
                  ".controller.ts",
                  ".gateway.ts"
                ],
                "classValidatorShim": true,
                "introspectComments": true
              }
            }
          ]
        },
        "configurations": {
          "development": {
            "args": [
              "--node-env=development"
            ]
          }
        },
        "// dependsOn": "^generate (#260): a cold build must produce the untracked Prisma client itself (the bundle imports it as a runtime value; i18n types are import-type and erased). Declare PER-PROJECT — a `build` key in nx.json targetDefaults creates a phantom build target on every source-only lib and fails them under @nx/enforce-module-boundaries. `^build` is repeated because a project-level dependsOn replaces a default rather than merging. Full reasoning: issue #260.",
        "dependsOn": [
          "generate",
          "^generate",
          "^build"
        ]
      },
      "serve": {
        "continuous": true,
        "executor": "@nx/js:node",
        "defaultConfiguration": "development",
        "dependsOn": [
          "build"
        ],
        "options": {
          "buildTarget": "@boardgamesempire/api:build",
          "runBuildTargetDependencies": false
        },
        "configurations": {
          "development": {
            "buildTarget": "@boardgamesempire/api:build:development"
          },
          "production": {
            "buildTarget": "@boardgamesempire/api:build:production"
          }
        }
      },
      "test": {
        "options": {
          "passWithNoTests": true
        }
      },
      "typecheck": {
        "dependsOn": [
          "generate",
          "^generate"
        ]
      }
    }
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "dotenv": "^17.4.1",
    "prisma": "^7.6.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.0.0"
  }
}
