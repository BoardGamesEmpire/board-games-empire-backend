// Why a copy left the user's collection, recorded on its removal, and on the
// entry with its last owned copy, so the "previously owned" view can say more
// than "gone" (#1231).
enum GameRemovalReason {
  Destroyed
  Gifted
  Lost
  Other
  Sold
  Stolen
  Traded

  @@map("game_removal_reasons")
}

// A collection entry: one game in a user's collection, with its copies
// (#1231). The entry keeps the user's relationship with the game (rating,
// comment, favorite, play history, reach); each copy keeps its own
// acquisition, condition, edition and removal.
model GameCollection {
  id String @id @default(cuid(2))

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @map("user_id")

  platformGame   PlatformGame @relation(fields: [platformGameId], references: [id], onDelete: Cascade)
  platformGameId String       @map("platform_game_id")

  medium GameMedium

  // Who may see this row beyond the owner and their households. Friends reach
  // honors UserPreferences.showCollectionToFriends. A household sees the row
  // whatever its reach, through the owner's HouseholdMember.collectionSharing flag
  // and excluded games instead (#495).
  reach Reach @default(Private)

  rating      Int?
  playCount   Int?      @map("play_count")
  playAgain   Boolean?  @map("play_again")
  favorite    Boolean?
  comment     String?
  lastPlayed  DateTime? @map("last_played") @db.Timestamptz(3)
  lastUpdated DateTime? @map("last_updated") @db.Timestamptz(3)

  // The entry's removal, a summary of its copies: set when its last owned copy
  // is removed, cleared when it has an owned copy again, in the same
  // transaction as the copy (#1231). It stays on the entry because the event,
  // household and list libs filter on it. The entry itself is never
  // hard-deleted, so play history (playCount, lastPlayed, playAgain, favorite)
  // survives a removal and an add-back, and the rows that name the entry
  // (locations, event game lists) stay.
  deletedAt    DateTime?          @map("deleted_at") @db.Timestamptz(3)
  deleteReason GameRemovalReason? @map("delete_reason")

  copies                 CollectionCopy[]
  ratingChanges          CollectionRatingChange[]
  excludedFromHouseholds ExcludedGame[]
  locations              GameLocation[]
  eventAttendeeGameLists EventAttendeeGameList[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([userId, platformGameId, medium])
  @@index([platformGameId])
  @@map("game_collections")
}
