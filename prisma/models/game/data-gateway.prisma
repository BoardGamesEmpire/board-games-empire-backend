model DataGateway {
  id          String  @id @default(cuid(2))
  name        String  @unique
  description String?

  messageContext String? @map("message_context")
  iconUrl        String? @map("icon_url")
  logoUrl        String? @map("logo_url")
  websiteUrl     String? @map("website_url")

  // Informational fields about the gateway's API (if applicable)
  apiBaseUrl       String? @map("api_base_url")
  apiDocumentation String? @map("api_documentation")
  apiVersion       String? @map("api_version")

  // Connection details for the gateway
  connectionUrl  String @map("connection_url")
  connectionPort Int    @map("connection_port")

  enabled        Boolean  @default(true)
  authType       AuthType @map("auth_type")
  authParameters Json?    @map("auth_parameters")

  usageCount Int       @default(0) @map("usage_count")
  lastUsed   DateTime? @map("last_used") @db.Timestamptz(3)

  // The DataGateway's answers to the server's interview. Each interview
  // overwrites them, and an answer it leaves unset is stored unset: null, or
  // an empty list. The lists are kept in their enum's order, so unchanged
  // answers are written identically, except acceptedLanguageCodeFormats,
  // which keeps the DataGateway's order, most preferred first.
  capabilities                DataGatewayCapability[] @default([])
  coveragePlatformTypes       PlatformType[]          @default([]) @map("coverage_platform_types")
  coverageContentTypes        ContentType[]           @default([]) @map("coverage_content_types")
  filterableAxes              CoverageAxis[]          @default([]) @map("filterable_axes")
  acceptedLanguageCodeFormats LanguageCodeFormat[]    @default([]) @map("accepted_language_code_formats")
  responseLanguageCodeFormat  LanguageCodeFormat?     @map("response_language_code_format")
  passthroughSearchLanguage   Boolean?                @map("passthrough_search_language")
  contentFormat               ContentFormat?          @map("content_format")
  // The version it reported on Ping at its last interview. A different one
  // reported since brings the next interview forward.
  gatewayVersion              String?                 @map("gateway_version")

  // Capabilities an admin switched off. The server doesn't route them, even
  // while the DataGateway declares them, and no interview writes this list.
  disabledCapabilities DataGatewayCapability[] @default([]) @map("disabled_capabilities")

  // The DataGateway isn't used until its first interview succeeds.
  firstInterviewedAt    DateTime?                    @map("first_interviewed_at") @db.Timestamptz(3)
  // The last interview that succeeded: its answers are the ones in use.
  lastInterviewedAt     DateTime?                    @map("last_interviewed_at") @db.Timestamptz(3)
  // The last interview that failed, and a coarse code for why. The admin
  // routes return these columns, so the raw error is only logged. A later
  // success leaves both in place: the failure is current while
  // lastInterviewFailedAt isn't before lastInterviewedAt. Each list job
  // records its own outcome in sections (#718).
  lastInterviewFailedAt DateTime?                    @map("last_interview_failed_at") @db.Timestamptz(3)
  lastInterviewFailure  DataGatewayInterviewFailure? @map("last_interview_failure")

  gameSources            GameSource[]
  importActivities       ImportActivity[]
  sections               DataGatewaySection[]
  userGatewayConnections UserGatewayConnection[]

  createdBy   User?   @relation("DataGatewayCreator", fields: [createdById], references: [id])
  createdById String? @map("created_by_id")

  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("data_gateways")
}

// An operation a DataGateway serves. Mirrors proto Capability
// (bge.gateway.v1).
enum DataGatewayCapability {
  Search
  Fetch
  FetchExpansions
  ListLanguages
  ListPlatforms
  ListCategories
  ListMechanics

  @@map("data_gateway_capabilities")
}

// A coverage axis a DataGateway's search can filter by. Mirrors proto
// CoverageAxis (bge.gateway.v1).
enum CoverageAxis {
  PlatformType
  ContentType

  @@map("coverage_axes")
}

// The form a DataGateway's free text arrives in. Mirrors proto ContentFormat
// (bge.gateway.v1).
enum ContentFormat {
  PlainText
  Html
  BBCode
  Markdown

  @@map("content_formats")
}

// Why an interview failed.
enum DataGatewayInterviewFailure {
  // The interview's ping went unanswered.
  PingFailed
  // The DataGateway doesn't implement Describe.
  DescribeUnsupported
  // Describe failed in some other way.
  DescribeFailed

  @@map("data_gateway_interview_failures")
}

// One list job's outcome for one DataGateway (#718). A failure is recorded
// after the job's last attempt, and is current while lastFailedAt isn't
// before lastLoadedAt, as on the interview.
model DataGatewaySection {
  dataGateway  DataGateway                @relation(fields: [gatewayId], references: [id], onDelete: Cascade)
  gatewayId    String                     @map("gateway_id")
  capability   DataGatewayCapability
  lastLoadedAt DateTime?                  @map("last_loaded_at") @db.Timestamptz(3)
  lastFailedAt DateTime?                  @map("last_failed_at") @db.Timestamptz(3)
  lastFailure  DataGatewaySectionFailure? @map("last_failure")

  @@id([gatewayId, capability])
  @@map("data_gateway_sections")
}

// Why a list job failed (#718).
enum DataGatewaySectionFailure {
  ListUnsupported // the DataGateway answered UNIMPLEMENTED
  ListFailed // the list call failed in some other way
  LinkFailed // the server couldn't write the links

  @@map("data_gateway_section_failures")
}
