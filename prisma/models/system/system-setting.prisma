model SystemSetting {
  id String @id @default(cuid(2))

  singleton  Boolean @unique @default(true)
  identifier String  @unique

  /// Human-readable server display name, surfaced in the anonymous
  /// /.well-known/bge-identity document so clients can label the server
  /// when a user is choosing which server to add.
  name String @default("Board Games Empire") @map("name")

  allowPasswordResets   Boolean @default(true) @map("allow_password_resets")
  allowUserRegistration Boolean @default(true) @map("allow_user_registration")
  allowUsernameChange   Boolean @default(true) @map("allow_username_change")

  feedbackReportRetentionDays          Int     @default(90) @map("feedback_report_retention_days")
  feedbackReportServerRedactionEnabled Boolean @default(true) @map("feedback_report_server_redaction_enabled")

  mediaSigningSecret          String? @map("media_signing_secret") // encrypted at rest (EncryptionService)
  requireContributionApproval Boolean @default(false) @map("require_contribution_approval")
  contributionReclaimDays     Int     @default(14) @map("contribution_reclaim_days")

  /// Audit rows older than this are soft-deleted by the retention sweep.
  /// Null (the default) means unlimited retention — the sweep is a no-op.
  auditLogRetentionDays Int? @map("audit_log_retention_days")

  /// When true, valid BCP 47 languages reported by gateways are held as
  /// Pending links for admin review instead of being auto-added.
  reviewGatewayLanguages Boolean @default(false) @map("review_gateway_languages")

  /// When true, a platform, category or mechanic a DataGateway sends that
  /// matches no record waits as a Pending link for admin review, instead of
  /// being added (#718). One setting per vocabulary.
  reviewGatewayPlatforms  Boolean @default(false) @map("review_gateway_platforms")
  reviewGatewayCategories Boolean @default(false) @map("review_gateway_categories")
  reviewGatewayMechanics  Boolean @default(false) @map("review_gateway_mechanics")

  /// Who may be invited to a household (#278). `Public`: anyone.
  /// `FriendsOfFriends`: the inviter's friends and friends of friends
  /// (#496), and `Friends`: the inviter's friends, each invited from their
  /// account; under both, every invite by address is refused. Under
  /// `FriendsOfFriends`, whether an invite by id passes shows the inviter
  /// whether the invitee shares a friend with them. The settings PATCH
  /// accepts no other level.
  householdInviteePolicy Reach @default(Public) @map("household_invitee_policy")

  /// Who may be invited to an event (#546), on the same terms as
  /// `householdInviteePolicy` but for events: a user placed on an event by id,
  /// at its creation or later. Set apart because joining a household shares
  /// its collection, while an event is one evening.
  eventInviteePolicy Reach @default(Public) @map("event_invitee_policy")

  /// Mail settings (#654): how the server sends outgoing mail. Nothing is sent
  /// until `smtpHost` and `mailFromAddress` are both set. They live only on
  /// this row, so a change applies to the next email without a restart.
  smtpHost        String?      @map("smtp_host")
  smtpPort        Int          @default(587) @map("smtp_port")
  smtpSecurity    SmtpSecurity @default(StartTls) @map("smtp_security")
  smtpUser        String?      @map("smtp_user")
  smtpPassword    String?      @map("smtp_password") // encrypted at rest (EncryptionService)
  mailFromAddress String?      @map("mail_from_address")

  /// How long a password reset link works, in minutes.
  passwordResetLinkLifetimeMinutes Int @default(1440) @map("password_reset_link_lifetime_minutes")

  // The three day counts (feedbackReportRetentionDays, contributionReclaimDays
  // and auditLogRetentionDays) are held to 1..36500 by CHECK constraints in
  // hand-written migration SQL (20261005000000_system_setting_day_bounds),
  // because Prisma cannot express them here. Null still passes for
  // auditLogRetentionDays. passwordResetLinkLifetimeMinutes (15..10080) and
  // smtpPort (1..65535) are held the same way, in 20261107120000_outgoing_mail.
  @@map("system_settings")
}

/// How the server secures its connection to the SMTP server (#654).
/// `StartTls` upgrades a plain connection, `ImplicitTls` is encrypted from the
/// first byte, and `None` is for a trusted local relay.
enum SmtpSecurity {
  StartTls
  ImplicitTls
  None

  @@map("smtp_security_types")
}
