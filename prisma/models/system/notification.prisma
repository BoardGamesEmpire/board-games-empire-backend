model Notification {
  id String @id @default(cuid(2))

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @map("user_id")

  type NotificationType

  read   Boolean   @default(false)
  readAt DateTime? @map("read_at") @db.Timestamptz(3)

  /**
   * Denormalized display data — enough to render a notification row
   * without joins. Shape varies by type:
   * GameImported / ExpansionImported:
   * { gameId, gameTitle, thumbnail, jobId, batchId }
   * WatchedExpansionImported:
   * { gameId, gameTitle, thumbnail, baseGameId, baseGameTitle }
   */
  payload Json

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  // Ordered unread fetch is the dominant read pattern
  @@index([userId, read, createdAt(sort: Desc)])
  @@map("notifications")
}

enum NotificationType {
  GameImported
  ExpansionImported
  WatchedExpansionImported
  /**
   * Import job failed terminally; payload distinguishes base game vs expansion.
   */
  ImportFailed

  MediaContributionRejected
  MediaContributionReclaimExpired

  /**
   * An auditable mutation event reached the audit listener with no populated
   * CLS actor scope — a code-path bug worth admin attention. Deduped per
   * event name while an unread notification exists.
   * Payload: { eventName, subject, source }
   */
  AuditUnattributedEvent

  /**
   * DataGateway notifications, each sent to the server admins (#763):
   * DataGatewayAutoDisabled: repeated failures switched the DataGateway off.
   * Payload: { gatewayId, gatewayName, reason, consecutiveFailures,
   * firstFailureAt, lastFailureAt, lastError }
   * DataGatewayCapabilitiesLost: an interview found capabilities gone that the
   * server was routing. Not sent again to a server admin whose unread one for
   * the DataGateway already names every capability lost.
   * Payload: { gatewayId, gatewayName, lostCapabilities }
   */
  DataGatewayAutoDisabled
  DataGatewayCapabilitiesLost

  /**
   * Household notifications, each sent to a different audience:
   * HouseholdInviteReceived: the invitee.
   * HouseholdInviteAwaitingApproval: household owners and admins.
   * HouseholdInviteAccepted: the household's members.
   * HouseholdInviteDeclined: the inviter plus household owners and admins.
   * HouseholdOwnershipTransferred: the new household owner.
   */
  HouseholdInviteReceived
  HouseholdInviteAwaitingApproval
  HouseholdInviteAccepted
  HouseholdInviteDeclined
  HouseholdOwnershipTransferred

  EventInviteReceived

  /**
   * Event occurrence notifications are sent to attendees when an occurrence they're attending changes status, and to hosts when an occurrence is proposed.
   * The same notification is sent for all status changes, with the type indicating the new status.
   */
  EventOccurrenceProposed
  EventOccurrenceConfirmed
  EventOccurrenceCanceled
  EventOccurrenceDeclined
  EventOccurrenceRescheduled
  EventRsvpReceived
  EventCreated

  /**
   * Nominations are created when a user nominates a game for an event, and resolved when a host approves/rejects it or it fails/passes a vote.
   * The same notification is sent to the nominator for all resolution outcomes, with the type indicating the outcome.
   */
  GameNominated
  GameNominationApproved // by (co)host
  GameNominationRejected
  GameNominationFailed
  GameNominationPassed // e.g. after a vote

  GameAddedToEvent

  /**
   * Game share notifications (#810), each sent to a different audience:
   * GameShareReceived: the user a share names, when it takes effect, which a
   * share to a user does on create.
   * GameShareAwaitingApproval: the owners and admins of the household a
   * member's share was made to, except the member, until one approves it.
   * A household share that takes effect on create tells nobody.
   */
  GameShareReceived
  GameShareAwaitingApproval

  @@map("notification_types")
}
