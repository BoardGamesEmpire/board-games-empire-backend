model Mechanic {
  id String @id @default(cuid(2))

  name        String  @unique
  slug        String  @unique // normalized for fuzzy dedup e.g. "worker-placement"
  description String?
  complexity  Int?

  usageCount         Int?   @map("usage_count")
  compatibilityScore Float? @map("compatibility_score")

  // Enrichment control
  enrichmentSource String?   @map("enrichment_source")
  frozenAt         DateTime? @map("frozen_at") @db.Timestamptz(3)

  games        GameMechanic[]
  favorites    FavoriteMechanic[]
  disliked     DislikedMechanic[]
  gatewayLinks MechanicGatewayLink[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, name: "idx_mechanics_name_trgm")
  @@map("mechanics")
}

// Maps a DataGateway's mechanic to a Mechanic record. A list job writes it
// after an interview, and an import writes one for a mechanic no list
// covered: linked to a record of the same slug or a similar name, or to a
// new one (#718). A Pending or Ignored link has no mechanic.
model MechanicGatewayLink {
  id String @id @default(cuid(2))

  mechanic   Mechanic? @relation(fields: [mechanicId], references: [id], onDelete: Cascade)
  mechanicId String?   @map("mechanic_id")

  gatewayId  String @map("gateway_id")
  externalId String @map("external_id")

  status VocabularyLinkStatus
  origin VocabularyLinkOrigin

  // The name the DataGateway sent, before normalization. Accept rebuilds
  // the record from it (#715, #718).
  suppliedName String @map("supplied_name")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([gatewayId, externalId])
  @@index([mechanicId])
  @@index([status])
  @@map("mechanic_gateway_links")
}

model GameMechanic {
  id String @id @default(cuid(2))

  game   Game   @relation(fields: [gameId], references: [id])
  gameId String @map("game_id")

  mechanic   Mechanic @relation(fields: [mechanicId], references: [id])
  mechanicId String   @map("mechanic_id")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([gameId, mechanicId])
  @@map("game_mechanics")
}
