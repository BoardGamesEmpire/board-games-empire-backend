/// Per-household enablement + configuration for Household-scoped plugins
/// (#59 consent-unit model). A row exists once a household enables the
/// plugin; absence means never enabled there.
///
/// `householdId` is a plain String id (no FK relation) to keep this file
/// from fanning edits into the household domain models — cleanup on
/// household deletion is owned by the uninstall/household-delete flows,
/// consistent with the AuditLog precedent.
model HouseholdPlugin {
  id String @id @default(cuid(2))

  householdId String @map("household_id")

  pluginId String @map("plugin_id")
  plugin   Plugin @relation(fields: [pluginId], references: [id], onDelete: Cascade)

  /// Household-level switch, layered UNDER Plugin.enabled — the household
  /// ADMIN's intent, and only theirs. Consent escalation never touches it
  /// at all: the serving predicate is `enabled && !suspendedForConsent`, so
  /// late acceptance restores exactly the state the admin chose.
  enabled Boolean @default(true)

  /// Consent suspension: an update escalated a permission to
  /// required at this scope and the household has not accepted. Set by
  /// activation (HouseholdPluginUnitDisabledEvent), cleared by the
  /// late-acceptance path in PluginGrantService.decide()
  /// (HouseholdPluginUnitEnabledEvent). The suspension CAUSE (the
  /// escalating slugs) rides the lifecycle events, not a column.
  suspendedForConsent Boolean   @default(false) @map("suspended_for_consent")
  suspendedAt         DateTime? @map("suspended_at") @db.Timestamptz(3)

  /// Household-scope plugin configuration (manifest config.schema governs
  /// the shape; requiresHouseholdConfig gates first enable).
  config Json @default("{}")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([householdId, pluginId])
  @@index([pluginId])
  @@map("household_plugins")
}
