/// Per-household enablement + configuration for Household-scoped plugins
/// (#59 consent-unit model). A row exists once a household enables the
/// plugin; absence means never enabled there.
///
/// `householdId` is a plain String id (no FK relation) to keep this file
/// from fanning edits into the household domain models — cleanup on
/// household deletion is owned by the uninstall/household-delete flows,
/// consistent with the AuditLog precedent.
model HouseholdPlugin {
  id String @id @default(cuid(2))

  householdId String @map("household_id")

  pluginId String @map("plugin_id")
  plugin   Plugin @relation(fields: [pluginId], references: [id], onDelete: Cascade)

  /// Household-level switch, layered UNDER Plugin.enabled — the household
  /// ADMIN's intent, and only theirs. Consent never touches it: consent
  /// standing is derived at read time from the manifest's requirements and
  /// the recorded grants (#1149), so a later consent changes what the
  /// ability confers and the unit's state code, never whether the unit is
  /// served, and never rewrites the admin's choice. The serving predicate is
  /// `enabled && dormantReason == null`.
  enabled Boolean @default(true)

  /// Household-scope plugin configuration (manifest config.schema governs
  /// the shape; requiresHouseholdConfig gates first enable).
  config Json @default("{}")

  /// Dormancy: the row is retained but cannot legitimately serve, and the
  /// unit did not ask for that (#369, #370). `null` is the ordinary case.
  /// Written ONLY by the transactions that replace a manifest — activation
  /// and reinstall-over-tombstone — never by a unit's own writer, which is
  /// what separates it from `enabled` (the admin's intent). The two are
  /// independent: the serving predicate is
  /// `enabled && dormantReason == null`.
  dormantReason PluginUnitDormantReason? @map("dormant_reason")

  /// When the CURRENT dormancy began. Carried for two reasons: an admin
  /// surface needs a "since", and the writer needs to identify the rows its
  /// own batched `updateMany` actually moved (the read-back in activation's
  /// passes keys on it).
  dormantAt DateTime? @map("dormant_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([householdId, pluginId])
  @@index([pluginId])
  @@map("household_plugins")
}
