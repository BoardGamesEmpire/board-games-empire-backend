/// Per-household enablement + configuration for Household-scoped plugins
/// (#59 consent-unit model). A switch-on consent act creates it (#1150);
/// absence means the household never switched the plugin on.
///
/// `householdId` is a plain String id (no FK relation) to keep this file
/// from fanning edits into the household domain models — cleanup on
/// household deletion is owned by the uninstall/household-delete flows,
/// consistent with the AuditLog precedent.
model HouseholdPlugin {
  id String @id @default(cuid(2))

  householdId String @map("household_id")

  pluginId String @map("plugin_id")
  plugin   Plugin @relation(fields: [pluginId], references: [id], onDelete: Cascade)

  /// Household-level switch, layered UNDER Plugin.enabled — the household
  /// admin's intent, and only theirs. A switch-on consent act creates the
  /// unit enablement switched on, and a review that refuses a required
  /// permission writes `enabled = false` in the same consent act (#1150).
  /// Any other consent decision leaves it alone: consent standing is derived
  /// at read time from the manifest's requirements and the recorded
  /// decisions (#1149), so it changes what the ability confers and the
  /// unit's state code, not whether the unit is served.
  ///
  /// This model holds the household's own intent (this switch and the
  /// configuration document below) and nothing else. Whether the unit can
  /// run, its dormancy, is worked out when read from the active manifest
  /// and this document (#1151): the unit is served when `enabled` is true
  /// and it has no dormancy.
  enabled Boolean @default(true)

  /// The household's configuration document. The active manifest's
  /// `config.schema` governs its shape; a document the schema rejects reads
  /// as dormant (`needs_configuration`) until the household supplies one
  /// that conforms (#1151). The switch-on and configuration writes validate
  /// the document they are given.
  config Json @default("{}")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([householdId, pluginId])
  @@index([pluginId])
  @@map("household_plugins")
}
