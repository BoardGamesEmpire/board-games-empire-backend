/// Catalog row for a plugin-DECLARED permission (#59). One row per
/// `permissions.declares[]` entry, created by the install pipeline (Phase
/// C2) and cascade-deleted with the plugin. Deliberately NOT a `Permission`
/// row: core `Permission.action` is the `Action` enum and carries seeded
/// ABAC condition templates, neither of which applies here — an
/// own-namespace grant becomes a CASL rule from the slug's parsed verb +
/// namespaced subject, with the plugin's own surface gating usage.
///
/// `slug` stores the CANONICAL full form `plugin|<pluginSlug>|<bareSlug>`
/// (generated by `expandPluginPermissionSlug`, never author-written), so the
/// unique index IS install-validation step 4's declares-collision check.
model PluginPermission {
  id String @id @default(cuid(2))

  pluginId String @map("plugin_id")
  plugin   Plugin @relation(fields: [pluginId], references: [id], onDelete: Cascade)

  /// Canonical full slug, e.g. `plugin|demo-sink|manage:digest`.
  slug String @unique

  /// Consent-surface risk classification. NO schema default on purpose —
  /// stricter than `Permission.riskLevel`: the install pipeline is the only
  /// writer and must classify explicitly: plugin-declared rows are locked to
  /// an explicit `Low`, and the manifest never self-declares risk.
  riskLevel RiskLevel @map("risk_level")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  /// Uninstall/reads: all declared permissions for a plugin.
  @@index([pluginId])
  @@map("plugin_permissions")
}
