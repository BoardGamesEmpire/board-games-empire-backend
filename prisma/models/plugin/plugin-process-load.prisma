/// The plugin artifact a running process loaded (#1094): one row per
/// (process, plugin). A process writes its row before it reads the plugin's
/// directory, marks it `ready` once the plugin's product is registered,
/// refreshes `heartbeatAt` every minute, writes a row again if it has gone
/// missing or holds a value the process failed to write, and deletes its rows
/// at a clean shutdown. A load that fails keeps its row, not ready, until
/// then.
/// The artifact sweep keeps the directory of any checksum a row with a fresh
/// heartbeat names, so it never removes code a running process still uses. A
/// process that dies without cleaning up leaves rows whose heartbeat goes
/// stale, and the sweep stops honouring them after five minutes.
/// A process that doesn't load a plugin reads these rows to learn whether one
/// of the process role that does has loaded this install of it (#1083).
///
/// `processId` is a random id made when the process starts, not a database
/// key: nothing else refers to it, so it is a plain String.
model PluginProcessLoad {
  processId String @map("process_id")

  /// What kind of process wrote the row ('api', and the worker roles later).
  processRole String @map("process_role")

  slug String

  /// SHA-256 of the plugin artifact the process loaded, lowercase hex.
  sha256 String

  /// The `installedAt` of the plugin row the process loaded (#1083). It names
  /// the install: a reinstall writes a new one and an update keeps it, so a
  /// row from before a reinstall says nothing about the code installed since.
  installedAt DateTime @map("installed_at") @db.Timestamptz(3)

  /// False while the load is under way and after one that failed; true once
  /// the plugin's product is registered in that process (#1083). Not
  /// `loaded`: `loadedAt` is when the load was recorded, before it ran.
  ready Boolean @default(false)

  loadedAt    DateTime @default(now()) @map("loaded_at") @db.Timestamptz(3)
  heartbeatAt DateTime @default(now()) @map("heartbeat_at") @db.Timestamptz(3)

  @@id([processId, slug])
  @@index([heartbeatAt])
  @@index([slug, processRole])
  @@map("plugin_process_loads")
}
