/// The user's unit enablement + configuration (#225 uniform-enablement
/// decision). A switch-on consent act creates it, whatever the act grants
/// or refuses (#1150), and it carries the user's `enabled` switch and
/// `config`. Absence means the user never switched the plugin on; durable
/// refusals live on PluginGrant.
///
/// Uniqueness is (userId, pluginId) with NO household dimension: user-scope
/// consent is household-agnostic, and reintroducing a household axis here
/// would quietly undo the consent-once-per-user model PluginGrant already
/// encodes.
///
/// `userId` carries a real FK with `onDelete: Cascade`, deliberately NOT
/// following HouseholdPlugin.householdId's plain-String shape: `Household`
/// is soft-deleted (`deletedAt`), so an unconstrained householdId never
/// dangles, whereas `User` rows are hard-deleted and an unconstrained
/// userId would orphan enablement rows on the very next account deletion.
/// The AuditLog precedent does not transfer either — that table is history,
/// where a stale id is a record; this one is live state a serving predicate
/// reads. Cascade matches UpstreamAccount: per-user configuration
/// dies with the user.
model UserPlugin {
  id String @id @default(cuid(2))

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  pluginId String @map("plugin_id")
  plugin   Plugin @relation(fields: [pluginId], references: [id], onDelete: Cascade)

  /// The user's own switch, layered UNDER Plugin.enabled and any household
  /// enablement — their intent, and only theirs. A switch-on consent act
  /// writes `enabled = true`, and a review that refuses a required permission
  /// writes `enabled = false` in the same consent act (#1150). Any other
  /// consent decision leaves it alone: consent standing is derived at read
  /// time from the manifest's requirements and the recorded decisions
  /// (#1149), so it changes what the ability confers and the unit's state
  /// code, not whether the unit is served.
  enabled Boolean @default(true)

  /// Per-user plugin configuration (manifest config.schema governs the
  /// shape). Ships with the anchor row but has no writer yet — the
  /// `requiresUserConfig` gate, write path, and config-updated event are
  /// #228 (#59 C4).
  config Json @default("{}")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([userId, pluginId])
  @@index([pluginId])
  @@map("user_plugins")
}
