/**
 * One attendee's state in their event's event chat (#1543): how far they have
 * read, a host mute on them, and their own chat mute. It hangs off the
 * attendee row, not the user, so it belongs to the one event. No row means
 * nothing read and no mute of either kind.
 */
model EventChatState {
  id String @id @default(cuid(2))

  attendee   EventAttendee @relation(fields: [attendeeId], references: [id], onDelete: Cascade)
  attendeeId String        @unique @map("attendee_id")

  // The highest sequence this attendee has read; messages above it are unread.
  lastReadSequence Int @default(0) @map("last_read_sequence")

  // A host mute: set by a host, co-host or event moderator, it stops the
  // attendee posting. A null end time mutes until lifted; a set one mutes
  // while it is still ahead. Removing the attendee clears it (#1543).
  hostMutedAt    DateTime? @map("host_muted_at") @db.Timestamptz(3)
  hostMutedUntil DateTime? @map("host_muted_until") @db.Timestamptz(3)

  // A chat mute: the attendee silencing this event chat's notifications for
  // themselves. It never stops them posting (#1543).
  chatMutedAt DateTime? @map("chat_muted_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("event_chat_states")
}
