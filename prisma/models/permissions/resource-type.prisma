enum ResourceType {
  // ─── System ─────────────────────────────────────────────
  SystemSetting
  AuditLog
  Notification
  SafeHttpPolicy
  Media
  MediaObject
  MediaContribution
  WebhookSubscription
  Quota
  Job

  // ─── Plugin ─────────────────────────────────────────────
  Plugin
  PluginGrant
  HouseholdPlugin
  UserPlugin
  PluginLifecycleEvent

  // ─── User ───────────────────────────────────────────────
  User
  UserProfile
  UserGameCustomization
  Friendship

  // ─── Feedback ───────────────────────────────────────────
  FeedbackReport
  FeedbackSinkDispatch

  // ─── Game ───────────────────────────────────────────────
  Campaign
  Game
  GameCollection
  GameCreationRequest
  GameCustomization
  DataGateway
  /// Asking the DataGateways, during a game search (#1076) or for a base game's
  /// expansions (#1067). No table behind it.
  DataGatewaySearch
  GamePlayResult
  GamePlaySession
  GameShare
  Platform
  PlatformGame
  RuleVariant
  SessionPlayer

  // ─── Household ──────────────────────────────────────────
  Household
  HouseholdMember
  HouseholdRole
  HouseholdBan
  Invite

  // ─── Event ──────────────────────────────────────────────
  Event
  EventAttendee
  EventAttendeeGameList
  EventAvailabilityVote
  EventGame
  EventGameNomination
  EventGameVote
  EventOccurrence
  EventPolicy

  // ─── Permission catalog ─────────────────────────────────
  // The permission catalog tables, as resource types so routes can name them
  // (#772). No role is given a slug on them: staff read them through their
  // read on `all`, and only the Owner's manage:all writes them.
  Permission
  Role
  RolePermission

  @@map("resource_types")
}
