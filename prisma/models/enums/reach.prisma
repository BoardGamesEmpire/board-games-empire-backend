/// How far past its owner something reaches: only them (`Private`), their
/// friends, friends of friends, their extended network, or everyone (`Public`).
/// Everyone is every signed-in user on the server, and for collection entries
/// anonymous users too (#484). The ladder reads upwards: each rung reaches
/// everyone the rung below it does. Direct friends read up the ladder through
/// the friends permissions, friends of friends through their own (#496), and
/// the extended network, up to three friendship steps away, through
/// permissions that read the extended network table (#497). A share adds
/// readers on top of a reach; it is a separate row, not a rung (#495).
enum Reach {
  ExtendedNetwork
  Friends
  FriendsOfFriends
  Private
  Public

  @@map("reach_types")
}
