# The port the api listens on. Default: 33333
PORT=33333

# Base URL where your API (and Better Auth endpoints) will live in dev.
# Required in production and staging.
BETTER_AUTH_URL=http://localhost:33333

# What Better Auth signs sessions with: any string of at least 10 characters,
# though Better Auth warns below 32. Development and test have a default;
# production and staging require it.
# tip: openssl rand -base64 32
#BETTER_AUTH_SECRET=
USE_EMAIL_PASSWORD_AUTH=true
# {PORT} becomes the api's port. Both spellings of this machine are listed,
# since a browser sends whichever one it was given.
TRUSTED_ORIGINS=http://localhost:{PORT},http://127.0.0.1:{PORT}
# dev only setting - not recommended for production
DISABLE_ORIGIN_CHECK=false

# TODO - implement OIDC auth providers
OIDC_WELL_KNOWN_URL=https://host.example.com/.well-known/slug
OIDC_CLIENT_ID=your-oidc-client-id
OIDC_CLIENT_SECRET=your-oidc-client-secret
OIDC_PROVIDER_ID=my-provider-name

# OpenTelemetry configuration - these are standard OTel environment variables.
# See https://opentelemetry.io/docs/specs/otel/configuration/sdk-environment-variables/ for more details.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_METRICS_EXPORTER=none
OTEL_LOGS_EXPORTER=none
OTEL_RESOURCE_ATTRIBUTES=

LOG_LEVEL=debug

# ── Plugins (#59/#212) ────────────────────────────────────────────────────
# Root for tarball-installed plugins (<PLUGINS_ROOT>/<slug>). Must be a
# persistent path — installed plugins whose directories vanish are
# force-disabled (quarantined) on the next boot.
# Defaults: /var/lib/bge/plugins in production, ./data/plugins elsewhere.
PLUGINS_ROOT=
# Root for plugins shipped in-tree with BGE. Provisional until the first
# bundled plugin (#61) fixes the dist layout. Default: ./plugins/bundled
PLUGINS_BUNDLED_ROOT=

# ── Media ────────────────────────────────────────────────────────────────
# Where media is stored. The api and the worker must share it, and in
# production it must be a persistent path. Defaults: /var/lib/bge/media in
# production, /tmp in development and test. Staging has none: set real storage.
#MEDIA_LOCAL_DISK_ROOT=
# The api's public URL followed by /api: the media links it signs point at
# <MEDIA_BASE_URL>/media-stream. Default: http://localhost:33333/api
MEDIA_BASE_URL=http://localhost:33333/api

# Postgres connection
# https://github.com/prisma/prisma/issues/28128
DATABASE_URL="postgresql://bge:password@localhost:5432/board_games_empire?schema=board_games_empire"
DATABASE_LOG_QUERIES=false

# Disable Prisma telemetry collection
CHECKPOINT_DISABLE=1

NODE_ENV=development
# Encrypts the secrets the server stores, such as webhook signing secrets: any
# string of at least 10 characters, and the same value for the api and the
# worker, since the worker decrypts what the api encrypted. Development and
# test have a default; production and staging require it.
# tip: openssl rand -base64 32
#DATA_ENCRYPTION_KEY=

# Prometheus metrics
PROMETHEUS_DEFAULT_METRICS_ENABLED=true
PROMETHEUS_DEFAULT_METRICS_PREFIX=bge_
PROMETHEUS_DEFAULT_METRICS_TIMEOUT=5000
PROMETHEUS_COLLECT_DEFAULT_METRICS=true

# Rate limiting. The window is MILLISECONDS — the variable is named for it
# because getting the unit wrong is silent in both directions: too small and the
# ceiling is unreachable, too large and it locks real traffic out. Values below
# 1000 are rejected at boot as a unit mistake. 60000 = one minute (#293).
THROTTLE_TTL_MS=60000
# Requests allowed per ROUTE, per IP, within one window — each endpoint carries
# its own count, so this is not a budget shared across a page load. WebSocket
# frames are held to the same number per gateway handler, per user.
THROTTLE_LIMIT=20
# How many trusted proxies sit in front of this app, deciding which address the
# IP tier counts. 0 ignores X-Forwarded-For entirely and keys on the peer — the
# right answer when nothing is in front, and the safe one when you are not sure.
# Raise it ONLY to the real number of proxies: every hop you add here is one
# more X-Forwarded-For entry the app believes, and the entries beyond your own
# infrastructure are written by the caller. Setting it too high is how rate
# limiting becomes bypassable (#340).
THROTTLE_TRUSTED_PROXY_HOPS=0

# Health checks
ENABLE_HEALTH_CHECKS=true

# Comma-separated list of name|url pairs for HTTP health checks
HTTP_HEALTH_CHECK_URLS=google|https://www.google.com,github|https://www.github.com

# Redis configuration - General purpose Redis connection for caching, session storage, etc.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=your_redis_password
REDIS_DATABASE=0
REDIS_TLS_ENABLED=false
# TODO: Support paths as well as inline certs/keys
# Double quotes turn each \n into a line break (docs/REDIS.md).
#REDIS_TLS_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
#REDIS_TLS_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
#REDIS_TLS_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# How long an api or worker cache entry lasts, in milliseconds, when its write
# sets no TTL of its own: at least 1, and five minutes unless set
# (docs/DEPLOYMENT.md).
#CACHE_TTL=300000

# TODO - make it less shitty to have multiple or share Redis connections

# Redis connection specifically for WebSocket server
REDIS_WEBSOCKET_HOST=localhost
REDIS_WEBSOCKET_PORT=6379
REDIS_WEBSOCKET_USERNAME=default
REDIS_WEBSOCKET_PASSWORD=your_redis_password
REDIS_WEBSOCKET_DATABASE=1
REDIS_WEBSOCKET_TLS_ENABLED=false
# TODO: Support paths as well as inline certs/keys
#REDIS_WEBSOCKET_TLS_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
#REDIS_WEBSOCKET_TLS_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
#REDIS_WEBSOCKET_TLS_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# Redis connection specifically for BullMQ
REDIS_BULLMQ_HOST=localhost
REDIS_BULLMQ_PORT=6379
REDIS_BULLMQ_USERNAME=default
REDIS_BULLMQ_PASSWORD=your_redis_password
REDIS_BULLMQ_DATABASE=2
REDIS_BULLMQ_TLS_ENABLED=false
# TODO: Support paths as well as inline certs/keys
#REDIS_BULLMQ_TLS_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
#REDIS_BULLMQ_TLS_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
#REDIS_BULLMQ_TLS_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# Coordinator gRPC server configuration
COORDINATOR_GRPC_HOST=0.0.0.0
COORDINATOR_GRPC_PORT=50052
COORDINATOR_VERSION=1.0.0

GATEWAY_COORDINATOR_HOST=localhost
GATEWAY_COORDINATOR_PORT=50052

# ---------- Gateway-specific settings ----------

# BoardGameGeek API key - only necessary if running the boardgamegeek-gateway
BOARDGAMEGEEK_API_KEY=your_bgg_api_key_here
BOARDGAMEGEEK_GATEWAY_GRPC_HOST=localhost
BOARDGAMEGEEK_GATEWAY_GRPC_PORT=50053

IGDB_CLIENT_ID=your_igdb_client_id_here
IGDB_CLIENT_SECRET=your_igdb_client_secret_here
IGDB_GATEWAY_GRPC_HOST=localhost
IGDB_GATEWAY_GRPC_PORT=50054
# Where the IGDB gateway gets its Twitch access token. Leave unset for Twitch's
# endpoint; the gateway e2e suite points it at a local stub. It must be https
# unless it points at this machine, because the request carries the secret.
# IGDB_TOKEN_URL=https://id.twitch.tv/oauth2/token
